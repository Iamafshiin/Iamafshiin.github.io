<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for lang, prefix in langs.items() %}
{% set root = "/" ~ prefix ~ "/" if prefix else "/" %}
  <url><loc>{{ site.site.url }}{{ root }}</loc><lastmod>{{ today }}</lastmod></url>
{% for study in studies %}
  <url><loc>{{ site.site.url }}{{ root }}case-studies/{{ study.slug }}/</loc><lastmod>{{ today }}</lastmod></url>
{% endfor %}
{% endfor %}
</urlset>
