{% extends "base.html.j2" %}
{% block title %}{{ study.title }} — {{ cv.name }}{% endblock %}
{% block description %}{{ study.role }} · {{ study.company }} · {{ study.period }}{% endblock %}
{% block canonical %}<link rel="canonical" href="{{ site.site.url }}/case-studies/{{ study.slug }}/">{% endblock %}
{% block head %}<script src="/assets/js/case-study.js" defer></script>{% endblock %}
{% block main %}
<div class="prog" id="prog" aria-hidden="true"></div>
<section class="cs-band">
  <div class="wrap">
    <a class="crumb" href="/#work">~/ <b>case-studies</b> / {{ study.slug }}</a>
    {% set parts = study.title.split(study.highlight, 1) %}
    <h1>{{ parts[0] }}<span class="hl">{{ study.highlight }}</span>{{ parts[1] }}</h1>
    <dl>
      <div><dt>role</dt><dd>{{ study.role }}</dd></div>
      <div><dt>company</dt><dd>{{ study.company }}</dd></div>
      <div><dt>period</dt><dd>{{ study.period }}</dd></div>
      <div><dt>stack</dt><dd class="mono">{{ study.stack | join(" · ") }}</dd></div>
    </dl>
  </div>
</section>
<div class="wrap cs-body">
{% for s in study.sections %}
  <section>
    <h2><span>{{ "%02d" | format(loop.index) }}</span>{{ s.heading }}</h2>
    <div class="prose">
      {{ s.body | safe }}
{% if s.heading == "approach" and study.diagram is defined and study.diagram == "credit-states" %}
      {% include "_credit-states.html.j2" %}
{% endif %}
    </div>
  </section>
{% endfor %}
  <section>
    <h2><span>{{ "%02d" | format(study.sections | length + 1) }}</span>stack</h2>
    <div class="chips">{% for t in study.stack %}<span>{{ t }}</span>{% endfor %}</div>
  </section>
  <nav class="cs-foot" aria-label="More case studies">
    <a href="/case-studies/{{ study.prev.slug }}/"><small>← previous</small>{{ study.prev.title }}</a>
    <a class="mail" href="mailto:{{ cv.email }}?subject={{ study.title | urlencode }}"><small>questions about this system?</small>Email me</a>
    <a class="next" href="/case-studies/{{ study.next.slug }}/"><small>next →</small>{{ study.next.title }}</a>
  </nav>
</div>
{% endblock %}
