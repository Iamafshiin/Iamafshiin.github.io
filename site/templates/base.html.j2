<!doctype html>
<html lang="{{ ui.lang }}" dir="{{ ui.dir }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{{ site.site.title }}{% endblock %}</title>
<meta name="description" content="{% block description %}{{ site.site.description }}{% endblock %}">
<meta name="author" content="{{ cv.name }}">
<meta name="theme-color" content="#faf8f4">
{% block canonical %}<link rel="canonical" href="{{ site.site.url }}{{ path }}">
<link rel="alternate" hreflang="{{ ui.lang }}" href="{{ site.site.url }}{{ path }}">
<link rel="alternate" hreflang="{{ ui.other_lang }}" href="{{ site.site.url }}{{ alt }}">{% endblock %}
<meta property="og:type" content="profile">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:locale" content="{{ "fa_IR" if ui.lang == "fa" else "en_US" }}">
<meta property="og:title" content="{{ self.title() }}">
<meta property="og:description" content="{{ self.description() }}">
<meta property="og:image" content="{{ site.site.url }}/assets/og-image.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
{% if ui.lang == "fa" %}
<link rel="preload" href="/assets/fonts/vazirmatn-var.woff2" as="font" type="font/woff2" crossorigin>
{% else %}
<link rel="preload" href="/assets/fonts/inter-var-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/space-grotesk-var-latin.woff2" as="font" type="font/woff2" crossorigin>
{% endif %}
<link rel="stylesheet" href="/assets/css/site.css">
</head>
<body>
<a class="skip" href="#main">{{ ui.skip }}</a>
{% set home = "" if page == "home" else root %}
<header class="nav">
  <div class="wrap">
    <a class="name" href="{{ root }}">{{ site.name }}</a>
    <nav aria-label="{{ ui.nav.label }}">
      <ul>
        <li><a href="{{ home }}#work">{{ ui.nav.work }}</a></li>
        <li><a href="{{ home }}#about">{{ ui.nav.about }}</a></li>
        <li><a href="{{ home }}#contact">{{ ui.nav.contact }}</a></li>
        <li><a class="lang" href="{{ alt }}" lang="{{ ui.other_lang }}" hreflang="{{ ui.other_lang }}" title="{{ ui.other_title }}">{{ ui.other_label }}</a></li>
        <li><a class="pdf" href="{{ site.site.resume_path }}">{{ ui.nav.resume }}</a></li>
      </ul>
    </nav>
  </div>
</header>
<main id="main">
{% block main %}{% endblock %}
</main>
<footer class="foot">
  <div class="wrap">© {{ year | num }} {{ site.name }}<span><a href="mailto:{{ cv.email }}">{{ ui.email }}</a><a href="{{ site.site.linkedin }}" rel="me noopener">LinkedIn</a><a href="{{ site.site.github }}" rel="me noopener">GitHub</a></span></div>
</footer>
</body>
</html>
