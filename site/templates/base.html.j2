<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{{ site.site.title }}{% endblock %}</title>
<meta name="description" content="{% block description %}{{ site.site.description }}{% endblock %}">
<meta name="author" content="{{ cv.name }}">
<meta name="theme-color" content="#070b16">
{% block canonical %}<link rel="canonical" href="{{ site.site.url }}/">{% endblock %}
<meta property="og:type" content="profile">
<meta property="og:site_name" content="{{ cv.name }}">
<meta property="og:title" content="{{ self.title() }}">
<meta property="og:description" content="{{ self.description() }}">
<meta property="og:image" content="{{ site.site.url }}/assets/og-image.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
<link rel="preload" href="/assets/fonts/inter-var-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/space-grotesk-var-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/jetbrains-mono-var-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/site.css">
{% block head %}{% endblock %}
<script src="/assets/js/palette.js" defer></script>
<script src="/assets/js/effects.js" defer></script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
{% set home = "" if page == "home" else "/" %}
<header class="nav">
  <div class="wrap">
    <a class="name" href="/">afshin.hasani<i>_</i></a>
    <nav aria-label="Primary">
      <ul>
        <li><a href="{{ home }}#work">Work</a></li>
        <li><a href="{{ home }}#experience">Experience</a></li>
        <li><a href="{{ home }}#open-source">Open source</a></li>
        <li><a href="{{ home }}#contact">Contact</a></li>
        <li><a class="pdf" href="{{ site.site.resume_path }}">Resume (PDF)</a></li>
        <li class="k-item"><button class="k" type="button" data-pal aria-label="Open command palette" hidden>⌘K</button></li>
      </ul>
    </nav>
  </div>
</header>
<main id="main">
{% block main %}{% endblock %}
</main>
<footer class="foot">
  <div class="wrap">© {{ year }} {{ cv.name }} · built from one Content Source</div>
</footer>
<div class="pal" id="pal" hidden>
  <div class="box" role="dialog" aria-modal="true" aria-label="Command palette">
    <input id="palin" placeholder="type a command…" autocomplete="off" aria-label="Command">
    <ul id="pallist" role="listbox"></ul>
  </div>
</div>
<div class="toast" id="toast" role="status" aria-live="polite"></div>
<script type="application/json" id="pal-data">{{ {
  "email": cv.email,
  "resume": site.site.resume_path,
  "github": site.site.github,
  "linkedin": site.site.linkedin,
  "studies": studies | map(attribute="title") | list,
  "slugs": studies | map(attribute="slug") | list
} | tojson }}</script>
</body>
</html>
